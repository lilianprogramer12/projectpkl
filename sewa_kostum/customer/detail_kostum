<?php
require '../config/database.php';

$id = isset($_GET['id']) ? (int)$_GET['id'] : 0;
$kostum = mysqli_fetch_assoc(mysqli_query($conn, "SELECT * FROM kostum WHERE id = $id"));

if (!$kostum) {
    header("Location: katalog.php");
    exit;
}

// Ambil riwayat jadwal sewa kostum ini dari pesanan aktif
$jadwal = mysqli_query($conn, "
    SELECT p.tanggal_pengambilan, p.tanggal_pemakaian, p.status_pesanan 
    FROM detail_pesanan dp 
    JOIN pesanan p ON dp.pesanan_id = p.id 
    WHERE dp.kostum_id = $id 
    ORDER BY p.tanggal_pemakaian DESC
");
